+rm -rf "$STAGE/JERICHO/MODS/bake/obj" "$STAGE/JERICHO/MODS/bake/lib" \
+       "$STAGE/JERICHO/MODS/bake/tools" "$STAGE/JERICHO/MODS/bake/.git"
 cd "$STAGE"
-"$SZ" a -tzip -mx=5 "$OUT" 'JERICHO/MODS/d1cars' | tail -2
+"$SZ" a -tzip -mx=5 "$OUT" 'JERICHO/MODS/bake' | tail -2
 
 echo "== Driver 1 car data (carhacks owns the baked LEVs) =="
 mkdir -p "$STAGE/JERICHO/MODS/carhacks"
@@ -102,7 +102,7 @@ if "$SZ" l "$OUT" | grep -aiE '(^|[\\/])\.git($|[\\/])|build\.log|modlist\.ini\.
 else
     echo "ok: no .git, no build.log, no stale modlist backup"
 fi
-echo "-- the exe that landed, and that d1cars' mod.toml is beside it --"
-"$SZ" l "$OUT" JERICHO.exe 'JERICHO/MODS/d1cars/mod.toml' 'JERICHO/MODS/carhacks/D1CARS/*' | tail -6
+echo "-- the exe that landed, and that bake's mod.toml is beside it --"
+"$SZ" l "$OUT" JERICHO.exe 'JERICHO/MODS/bake/mod.toml' 'JERICHO/MODS/carhacks/D1CARS/*' | tail -6
 echo "-- size --"
 ls -la "$OUT"
