+# (bake, formerly d1cars, is a release mod now, so the public package carries it too).
 set -e
 HERE="$(cd "$(dirname "$0")" && pwd)"
 ROOT="$(cd "$HERE/../../../../.." && pwd)"
@@ -36,7 +36,7 @@ STAGE="${TMPDIR:-/tmp}/micheal_stage_$SHA"
 
